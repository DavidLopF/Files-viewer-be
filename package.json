{
  "name": "tbx-files-api",
  "version": "1.0.0",
  "description": "API REST que agrega y normaliza archivos CSV de un proveedor externo inestable",
  "main": "src/server.js",
  "license": "MIT",
  "engines": {
    "node": "14.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
    "test": "mocha --recursive test/unit test/integration",
    "coverage": "nyc --reporter=text --reporter=html npm test",
    "lint": "standard"
  },
  "dependencies": {
    "axios": "1.7.9",
    "cors": "2.8.5",
    "express": "4.21.2"
  },
  "devDependencies": {
    "chai": "4.5.0",
    "mocha": "10.8.2",
    "nock": "13.5.6",
    "nodemon": "2.0.22",
    "nyc": "15.1.0",
    "standard": "17.1.2",
    "supertest": "6.3.4"
  },
  "standard": {
    "env": [
      "mocha"
    ]
  }
}
